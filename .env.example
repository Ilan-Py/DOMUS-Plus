# Copy to .env (repo root) and fill in real values.
# Used by docker-compose.yml for both the db and backend services.
# .env is NOT committed (see .gitignore).

# Local Postgres in Docker (docker-compose.yml `db` service) runs with
# POSTGRES_HOST_AUTH_METHOD: trust — DB_PASSWORD is effectively ignored for
# that container. It's still read here because backend/.env (used when
# running the backend natively, outside Docker) needs a real value if you
# point DB_HOST at Supabase instead — see backend/.env.example.
DB_PASSWORD=
DB_NAME=domus_db

JWT_SECRET=domus_secret_key_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Cloudinary — crear una cuenta gratis en https://cloudinary.com y pegar acá
# los 3 valores reales del dashboard (Settings > API Keys). Sin esto, subir
# adjuntos (fotos/PDF) va a fallar al iniciar el backend.
CLOUDINARY_CLOUD_NAME=REEMPLAZAR_CON_TU_CLOUD_NAME
CLOUDINARY_API_KEY=REEMPLAZAR_CON_TU_API_KEY
CLOUDINARY_API_SECRET=REEMPLAZAR_CON_TU_API_SECRET
