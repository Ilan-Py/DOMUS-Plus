# Copiar como .env y completar con valores reales
# .env NO se sube al repo (está en .gitignore)

PORT=3000

# --- Postgres local (Docker, docker-compose.yml) ---
# Valores por default si corrés el backend DENTRO de Docker (docker-compose
# ya los pasa por su cuenta, esto es para cuando corrés `npm run dev` nativo
# contra el mismo contenedor de Postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=domus_db
DB_SSL=false

# --- Supabase (staging/prod) ---
# Descomentar y completar con los valores reales del dashboard de Supabase
# (Settings > Database > Connection Pooling > Session mode) en vez de los
# de arriba. IMPORTANTE: usar el connection string del "Session pooler"
# (host tipo aws-0-<region>.pooler.supabase.com, usuario
# postgres.<project-ref>), NO el de conexión directa (db.<project-ref>.
# supabase.co) — ese resuelve solo a IPv6 y falla en redes/Docker sin
# salida IPv6 configurada (confirmado en este proyecto: ENOTFOUND tanto
# desde Node nativo como desde dentro de un contenedor Docker Desktop).
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<password real de Supabase>
# DB_NAME=postgres
# DB_SSL=true

JWT_SECRET=domus_secret_key_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Cloudinary — crear una cuenta gratis en https://cloudinary.com y pegar acá
# los 3 valores reales del dashboard (Settings > API Keys).
CLOUDINARY_CLOUD_NAME=REEMPLAZAR_CON_TU_CLOUD_NAME
CLOUDINARY_API_KEY=REEMPLAZAR_CON_TU_API_KEY
CLOUDINARY_API_SECRET=REEMPLAZAR_CON_TU_API_SECRET
