// ============================================================
// DOMUS+ | schema.prisma
// Motor: PostgreSQL 15+ (local Docker o Supabase)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// Prisma declara los ENUMs acá y los genera como tipos Postgres
// nativos al correr la migración — equivalente a los CREATE TYPE
// del 01_schema.sql original.
// ------------------------------------------------------------

enum TipoIntegrante {
  adulto
  menor
  mayor
}

enum RolMiembro {
  dueno    // Prisma no admite ñ en nombres de enum: en la BD queda 'dueno'; la API lo devuelve como 'dueño' (listarMiembros)
  miembro

  @@map("rol_miembro")
}

// Rol en el sistema (no en la familia): 'admin' ve el registro de actividad y las
// estadísticas generales. Sólo se asigna desde el seed o la base, nunca desde la API.
enum RolSistema {
  usuario
  admin

  @@map("rol_sistema")
}

// Tipos de acción del registro de actividad. 'consulta' la usa sólo el admin al
// identificar una cuenta (queda registrado quién la identificó y por qué).
enum AccionRegistro {
  login
  alta
  modificacion
  eliminacion
  consulta

  @@map("accion_registro")
}

enum TipoRecordatorio {
  vacuna
  control
  medicacion
}

// Marca de un recordatorio (docs/ux/03-definicion.md §2): pendiente hasta que alguien dice si se hizo.
// «omitido» = se marcó que no se dio / no fue. `activo` se mantiene en sincronía (activo = estado pendiente).
enum EstadoRecordatorio {
  pendiente
  hecho
  omitido
}

enum TipoArchivoAdjunto {
  imagen
  pdf
}

// ------------------------------------------------------------
// 1. Usuario
// ------------------------------------------------------------
model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(100)
  apellido     String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  rol          RolSistema @default(usuario)
  // Avatar elegido (id del catálogo de la app, ej. "dog-floppy"); null = iniciales o huellita.
  avatarId     String?  @map("avatar_id") @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relaciones
  membresia        GrupoMiembro?
  recordatorios    Recordatorio[] @relation("RecordatorioCreadoPor")
  marcasHechas     Recordatorio[] @relation("RecordatorioMarcadoPor")
  adjuntosSubidos  Adjunto[]      @relation("AdjuntoSubidoPor")
  actividad        RegistroActividad[]

  @@map("usuario")
}

// ------------------------------------------------------------
// 2. GrupoFamiliar
// Sin usuario_id directo — la pertenencia es siempre vía GrupoMiembro.
// ------------------------------------------------------------
model GrupoFamiliar {
  id                Int      @id @default(autoincrement())
  nombre            String   @db.VarChar(150)
  codigoInvitacion  String?  @unique @map("codigo_invitacion") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at")

  // Relaciones
  miembros      GrupoMiembro[]
  integrantes   Integrante[]
  mascotas      Mascota[]
  recordatorios Recordatorio[]

  @@map("grupo_familiar")
}

// ------------------------------------------------------------
// 3. GrupoMiembro
// Un usuario pertenece a lo sumo a un grupo (unique en usuario_id).
// ------------------------------------------------------------
model GrupoMiembro {
  id        Int        @id @default(autoincrement())
  grupoId   Int        @map("grupo_id")
  usuarioId Int        @unique @map("usuario_id")
  rol       RolMiembro @default(miembro)
  joinedAt  DateTime   @default(now()) @map("joined_at")

  // Relaciones
  grupo   GrupoFamiliar @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("grupo_miembro")
}

// ------------------------------------------------------------
// 4. Integrante
// Incluye campos de ficha de emergencia (alergias, tipo_sangre, notas_emergencia).
// ------------------------------------------------------------
model Integrante {
  id               Int             @id @default(autoincrement())
  grupoId          Int             @map("grupo_id")
  nombre           String          @db.VarChar(100)
  apellido         String          @db.VarChar(100)
  fechaNacimiento  DateTime        @map("fecha_nacimiento") @db.Date
  tipo             TipoIntegrante  @default(adulto)
  observaciones    String?         @db.Text
  alergias         String?         @db.Text
  tipoSangre       String?         @map("tipo_sangre") @db.VarChar(10)
  notasEmergencia  String?         @map("notas_emergencia") @db.Text

  // Foto de perfil: ruta relativa (ej. /fotos/moni.jpg) servida por el backend; la app la
  // antepone a la URL de la API. Sin foto, la app muestra las iniciales.
  fotoUrl          String?         @map("foto_url") @db.VarChar(500)
  avatarId         String?         @map("avatar_id") @db.VarChar(40)

  // Relaciones
  grupo               GrupoFamiliar        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  vacunas             Vacuna[]
  tratamientos        Tratamiento[]
  historial           Historial[]
  contactosEmergencia ContactoEmergencia[]
  profesionales       ProfesionalSalud[]
  adjuntos            Adjunto[]            @relation("AdjuntoIntegrante")
  recordatorios       Recordatorio[]

  @@map("integrante")
}

// ------------------------------------------------------------
// 5. Mascota
// ------------------------------------------------------------
model Mascota {
  id               Int       @id @default(autoincrement())
  grupoId          Int       @map("grupo_id")
  nombre           String    @db.VarChar(100)
  especie          String    @db.VarChar(50)
  raza             String?   @db.VarChar(100)
  fechaNacimiento  DateTime? @map("fecha_nacimiento") @db.Date

  // Foto de perfil (ver Integrante.fotoUrl).
  fotoUrl      String?          @map("foto_url") @db.VarChar(500)
  avatarId     String?          @map("avatar_id") @db.VarChar(40)

  // Relaciones
  grupo        GrupoFamiliar    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  vacunas      Vacuna[]
  tratamientos Tratamiento[]
  historial    Historial[]
  profesionales ProfesionalSalud[]
  adjuntos     Adjunto[]        @relation("AdjuntoMascota")
  recordatorios Recordatorio[]

  @@map("mascota")
}

// ------------------------------------------------------------
// 6. Vacuna
// Solo uno de (integranteId, mascotaId) poblado.
// Prisma no soporta CHECK constraints — la validación
// "exactamente uno de los dos" se mantiene en el controller,
// igual que ya se hacía. La migración genera la tabla sin el CHECK;
// si se necesita el CHECK en la BD se puede agregar con una
// migración raw (ver docs de Prisma: prisma migrate dev + SQL manual).
// ------------------------------------------------------------
model Vacuna {
  id               Int       @id @default(autoincrement())
  integranteId     Int?      @map("integrante_id")
  mascotaId        Int?      @map("mascota_id")
  nombre           String    @db.VarChar(150)
  fechaAplicacion  DateTime  @map("fecha_aplicacion") @db.Date
  proximaDosis     DateTime? @map("proxima_dosis") @db.Date
  notas            String?   @db.Text

  // Relaciones
  integrante    Integrante?    @relation(fields: [integranteId], references: [id], onDelete: Cascade)
  mascota       Mascota?       @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  recordatorios Recordatorio[]
  adjuntos      Adjunto[]      @relation("AdjuntoVacuna")

  @@map("vacuna")
}

// ------------------------------------------------------------
// 7. Tratamiento
// ------------------------------------------------------------
model Tratamiento {
  id            Int       @id @default(autoincrement())
  integranteId  Int?      @map("integrante_id")
  mascotaId     Int?      @map("mascota_id")
  descripcion   String    @db.VarChar(255)
  medicacion    String    @db.VarChar(200)
  fechaInicio   DateTime  @map("fecha_inicio") @db.Date
  fechaFin      DateTime? @map("fecha_fin") @db.Date

  // Relaciones
  integrante    Integrante?    @relation(fields: [integranteId], references: [id], onDelete: Cascade)
  mascota       Mascota?       @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  recordatorios Recordatorio[]
  adjuntos      Adjunto[]      @relation("AdjuntoTratamiento")

  @@map("tratamiento")
}

// ------------------------------------------------------------
// 8. Historial
// ------------------------------------------------------------
model Historial {
  id            Int       @id @default(autoincrement())
  integranteId  Int?      @map("integrante_id")
  mascotaId     Int?      @map("mascota_id")
  evento        String    @db.VarChar(200)
  fecha         DateTime  @db.Date
  descripcion   String?   @db.Text

  // Relaciones
  integrante Integrante? @relation(fields: [integranteId], references: [id], onDelete: Cascade)
  mascota    Mascota?    @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  adjuntos   Adjunto[]   @relation("AdjuntoHistorial")

  @@map("historial")
}

// ------------------------------------------------------------
// 9. Recordatorio
// Compartido por grupo. creado_por registra quién lo creó.
// ------------------------------------------------------------
model Recordatorio {
  id             Int              @id @default(autoincrement())
  grupoId        Int              @map("grupo_id")
  creadoPor      Int              @map("creado_por")
  vacunaId       Int?             @map("vacuna_id")
  tratamientoId  Int?             @map("tratamiento_id")
  tipo           TipoRecordatorio
  fechaHora      DateTime         @map("fecha_hora")
  descripcion    String?          @db.VarChar(255)
  activo         Boolean          @default(true)
  // MEJ-005: recordatorios periódicos. Cada repetición es una fila propia; las de
  // una misma serie comparten serie_id. repeticion_dias = cada cuántos días se repite.
  serieId        String?          @map("serie_id") @db.Uuid
  repeticionDias Int?             @map("repeticion_dias")
  // "Para quién" es el recordatorio: un integrante O una mascota del grupo (o ninguno).
  integranteId   Int?             @map("integrante_id")
  mascotaId      Int?             @map("mascota_id")
  // Quién marcó y cuándo pasó (no cuándo se tocó el botón): «se la dimos a las 09:30» aunque se marque a la tarde.
  estado         EstadoRecordatorio @default(pendiente)
  hechoA         DateTime?        @map("hecho_a")
  hechoPor       Int?             @map("hecho_por")

  // Relaciones
  grupo       GrupoFamiliar @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario     Usuario       @relation("RecordatorioCreadoPor", fields: [creadoPor], references: [id], onDelete: Cascade)
  marcadoPor  Usuario?      @relation("RecordatorioMarcadoPor", fields: [hechoPor], references: [id], onDelete: SetNull)
  vacuna      Vacuna?       @relation(fields: [vacunaId], references: [id], onDelete: SetNull)
  tratamiento Tratamiento?  @relation(fields: [tratamientoId], references: [id], onDelete: SetNull)
  integrante  Integrante?   @relation(fields: [integranteId], references: [id], onDelete: SetNull)
  mascota     Mascota?      @relation(fields: [mascotaId], references: [id], onDelete: SetNull)

  @@index([serieId])
  @@map("recordatorio")
}

// ------------------------------------------------------------
// 10. Adjunto
// Polimórfica de 5 padres posibles — exactamente uno poblado.
// Igual que Vacuna/Tratamiento/Historial: el CHECK "un solo padre"
// no lo genera Prisma; se valida en el controller (adjuntoController.js).
// ------------------------------------------------------------
model Adjunto {
  id             Int                @id @default(autoincrement())
  vacunaId       Int?               @map("vacuna_id")
  tratamientoId  Int?               @map("tratamiento_id")
  historialId    Int?               @map("historial_id")
  integranteId   Int?               @map("integrante_id")
  mascotaId      Int?               @map("mascota_id")
  tipoArchivo    TipoArchivoAdjunto @map("tipo_archivo")
  url            String             @db.VarChar(500)
  publicId       String             @map("public_id") @db.VarChar(255)
  nombreOriginal String?            @map("nombre_original") @db.VarChar(255)
  subidoPor      Int                @map("subido_por")
  subidoEn       DateTime           @default(now()) @map("subido_en")

  // Relaciones
  vacuna      Vacuna?     @relation("AdjuntoVacuna",      fields: [vacunaId],      references: [id], onDelete: Cascade)
  tratamiento Tratamiento? @relation("AdjuntoTratamiento", fields: [tratamientoId], references: [id], onDelete: Cascade)
  historial   Historial?  @relation("AdjuntoHistorial",   fields: [historialId],   references: [id], onDelete: Cascade)
  integrante  Integrante? @relation("AdjuntoIntegrante",  fields: [integranteId],  references: [id], onDelete: Cascade)
  mascota     Mascota?    @relation("AdjuntoMascota",     fields: [mascotaId],     references: [id], onDelete: Cascade)
  usuario     Usuario     @relation("AdjuntoSubidoPor",   fields: [subidoPor],     references: [id])

  @@map("adjunto")
}

// ------------------------------------------------------------
// 11. ContactoEmergencia
// ------------------------------------------------------------
model ContactoEmergencia {
  id            Int        @id @default(autoincrement())
  integranteId  Int        @map("integrante_id")
  nombre        String     @db.VarChar(150)
  telefono      String     @db.VarChar(30)
  relacion      String?    @db.VarChar(100)

  // Relaciones
  integrante Integrante @relation(fields: [integranteId], references: [id], onDelete: Cascade)

  @@map("contacto_emergencia")
}

// ------------------------------------------------------------
// 12. ProfesionalSalud
// Polimórfica de 2 padres — igual que Vacuna: validación en controller.
// ------------------------------------------------------------
model ProfesionalSalud {
  id            Int     @id @default(autoincrement())
  integranteId  Int?    @map("integrante_id")
  mascotaId     Int?    @map("mascota_id")
  nombre        String  @db.VarChar(150)
  especialidad  String? @db.VarChar(100)
  telefono      String? @db.VarChar(30)
  direccion     String? @db.VarChar(255)
  notas         String? @db.Text

  // Relaciones
  integrante Integrante? @relation(fields: [integranteId], references: [id], onDelete: Cascade)
  mascota    Mascota?    @relation(fields: [mascotaId],    references: [id], onDelete: Cascade)

  @@map("profesional_salud")
}

// ------------------------------------------------------------
// Registro de actividad (auditoría)
// Quién hizo qué tipo de acción, sobre qué tipo de dato y cuándo. Nunca guarda el
// contenido (ni contraseñas, ni datos médicos, ni lo que se cargó en el formulario):
// sólo la acción, el nombre de la entidad y su id. Lo lee sólo el admin.
// Se borra lo que tiene más de RETENCION_ACTIVIDAD_DIAS días (ver utils/actividad.js).
// ------------------------------------------------------------
model RegistroActividad {
  id        Int            @id @default(autoincrement())
  usuarioId Int?           @map("usuario_id")
  accion    AccionRegistro
  entidad   String?        @db.VarChar(40)  // 'vacuna', 'integrante', 'perfil'...
  entidadId Int?           @map("entidad_id")
  detalle   String?        @db.VarChar(200) // sólo el motivo del admin al identificar una cuenta
  fecha     DateTime       @default(now())

  // Relaciones
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([usuarioId])
  @@map("registro_actividad")
}
