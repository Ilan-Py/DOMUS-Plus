{
  "expo": {
    "name": "DOMUS+",
    "slug": "domus-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F9FC"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F9FC"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "apiUrlProd": "https://REPLACE_WITH_PROD_HOST",
      "apiUrlLan": "http://192.168.0.8:3000",
      "useLanIp": false
    }
  }
}
